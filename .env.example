APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pdf.trackingmouthefirst.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Zoho CRM (US data center)  — สร้าง Self Client ที่ https://api-console.zoho.com
# ---------------------------------------------------------------------
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_API_VERSION=v8
ZOHO_ORG_ID=853559971
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_HTTP_TIMEOUT=20
ZOHO_LOG_LEVEL=info
# API name ของ custom field ใน subform Quoted_Items (แก้ให้ตรงกับ CRM จริง)
ZOHO_ITEM_RECURRING_FIELD=Recurring_Amount
ZOHO_ITEM_UNIT_FIELD=Unit

# ---------------------------------------------------------------------
# Quote PDF
# ---------------------------------------------------------------------
# สร้างด้วย: php -r "echo bin2hex(random_bytes(32));"  (ต้องตรงกับฝั่ง Deluge)
QUOTE_LINK_SECRET=
QUOTE_SIGNATURE_LENGTH=64
QUOTE_BASE_URL=https://pdf.trackingmouthefirst.com
QUOTE_RATE_LIMIT=30
QUOTE_RETENTION_DAYS=7
QUOTE_FORM_CODE=FA-SA-02-103
QUOTE_SHOW_QR=false

COMPANY_NAME_TH="บริษัทนำคนต่างด้าวมาทำงานในประเทศ เดอะ เฟิร์ส กูด แมน กรุ๊ป จำกัด"
COMPANY_NAME_EN="The First Goodman Group Co., Ltd."
COMPANY_ADDRESS=""
COMPANY_TAX_ID="0105559140065"
COMPANY_PHONE=""
COMPANY_EMAIL=""
COMPANY_WEBSITE=""

# ---------------------------------------------------------------------
# API name ของ custom field ในฟอร์ม FA-SA (ดู Setup > Developer Space > APIs > API Names)
# ---------------------------------------------------------------------
ZOHO_ITEMS_SUBFORM=Quoted_Items
ZOHO_FIELD_QUOTE_NUMBER=Quotation_Number
ZOHO_FIELD_QUOTE_DATE=field2
ZOHO_FIELD_SERVICE_SUBJECT=field6
ZOHO_FIELD_SALES_FIRST_NAME=First_Name
ZOHO_FIELD_SALES_LAST_NAME=Last_Name
ZOHO_FIELD_EMPLOYEE_LOOKUP=Sales_Code
ZOHO_EMPLOYEE_MODULE=Staffs
ZOHO_FIELD_EMPLOYEE_NICKNAME=Nickname
ZOHO_FIELD_PAYMENT_TERMS=field7
ZOHO_FIELD_ISO=ISO
QUOTE_FONT=thsarabunnew
QUOTE_APPROVER_NAME="นายเฟื่องฟู ชีวินมหรัตน์"
QUOTE_APPROVER_TITLE="กรรมการผู้จัดการ/ผู้อนุมัติราคา"

# เปิด URL แบบสั้น https://pdf.trackingmouthefirst.com/{record_id} สำหรับปุ่มใน CRM (ไม่มี signature)
QUOTE_ALLOW_UNSIGNED=true
# รูปลายเซ็นผู้อนุมัติ (เว้นว่าง = ไม่พิมพ์ลายเซ็น) ค่าเริ่มต้น resources/images/signature-approver.png
#QUOTE_APPROVER_SIGNATURE=
QUOTE_APPROVER_SIGNATURE_HEIGHT=34
# ฟอร์มเริ่มต้นเมื่อ URL ไม่ระบุชื่อฟอร์ม (ไฟล์ resources/views/pdf/forms/<slug>.blade.php)
QUOTE_DEFAULT_FORM=FA-SA-TH
# Quote Stage ที่แสดงวันที่ในเอกสาร (คั่นด้วยจุลภาค)
QUOTE_APPROVED_STAGES="อนุมัติ,Confirmed"
# หน้า 1 = รายการสินค้า, หน้า 2 = เงื่อนไข/สิทธิประโยชน์ + ลงนาม (false = ต่อกันในหน้าเดียว)
QUOTE_TERMS_ON_NEW_PAGE=true
# เติมแถวว่างในตารางรายการให้พอดีกรอบโดยวัดพื้นที่จริง
QUOTE_FILL_ITEM_ROWS=false
# แถวขั้นต่ำในตาราง (0 = แสดงเท่าที่มีรายการ)
QUOTE_MIN_ITEM_ROWS=0
# วาดกรอบรอบเนื้อหาทุกหน้า (true/false)
QUOTE_FRAME=false
ZOHO_FIELD_EMPLOYEE_SIGNATURE=Image_Sing
